# Copy to .env.local and fill in. Never commit real keys.

# --- Next.js app (public, sent to the browser) ---
# Supabase project URL and anon key (Supabase dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Local scripts only (backend/scripts/uploadTokens.js) ---
# Service-role key bypasses row-level security. Keep it out of the app and CI.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
